# AI Personal Workspace - Backend Environment Variables

# API Settings
PROJECT_NAME="AI Personal Workspace"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
# In production, use a strong, randomly generated string
SECRET_KEY="supersecretkeychangeinproduction1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL + pgvector)
# Example: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg2://postgres:password@db:5432/ai_workspace

# Redis Connection (Celery broker)
REDIS_URL=redis://redis:6379/0

# AI Configuration
# Get this from https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
